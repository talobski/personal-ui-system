  {
    "name": "small mobile native select text",
    "state": {
      "kind": "field-composition", "orientation": "vertical", "label": { "kind": "visible", "text": "Country", "htmlFor": "country" }, "descriptionId": null,
      "control": { "kind": "native-select", "id": "country", "disabled": false, "invalid": false, "error": null, "ariaDescribedBy": [], "mobileTextPx": 14, "options": [{ "label": "Philippines", "value": "ph" }], "value": "ph" }
    },
    "expected": { "ruleId": "native-select.mobile-text-size", "path": "control.mobileTextPx" }
