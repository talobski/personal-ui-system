    "expected": { "ruleId": "native-select.error-association", "path": "control.ariaDescribedBy" }
  },
  {
    "name": "duplicate native select values",
    "state": {
      "kind": "field-composition", "orientation": "vertical", "label": { "kind": "visible", "text": "Country", "htmlFor": "country" }, "descriptionId": null,
      "control": { "kind": "native-select", "id": "country", "disabled": false, "invalid": false, "error": null, "ariaDescribedBy": [], "mobileTextPx": 16, "options": [{ "label": "Philippines", "value": "ph" }, { "label": "Duplicate", "value": "ph" }], "value": "ph" }
    },
    "expected": { "ruleId": "native-select.option-values", "path": "control.options" }
  },
  {
