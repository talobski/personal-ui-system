      "control": { "kind": "native-select", "id": "country", "disabled": false, "invalid": false, "error": null, "ariaDescribedBy": [], "mobileTextPx": 16, "options": [{ "label": "Philippines", "value": "ph" }], "value": "ph" }
    },
    "expected": { "ruleId": "field.label-association", "path": "label.htmlFor" }
  },
  {
