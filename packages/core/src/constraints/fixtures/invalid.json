    "state": {
      "kind": "field-composition", "orientation": "vertical", "label": { "kind": "visible", "text": "Country", "htmlFor": "country" }, "descriptionId": null,
      "control": { "kind": "native-select", "id": "country", "disabled": false, "invalid": true, "error": { "id": "country-error", "message": "Choose a country." }, "ariaDescribedBy": [], "mobileTextPx": 16, "options": [{ "label": "Philippines", "value": "ph" }], "value": "ph" }
