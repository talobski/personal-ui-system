        }
      ]
    },
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "-2px",
          "color": "oklch(0 0 0 / 10%)"
        }
      ]
    },
    "lg": {
      "$type": "shadow",
      "$value": [
