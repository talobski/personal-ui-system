{
  "name": "personal-ui-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p e2e && tsc -p tools/loop/jev",
    "registry:build": "shadcn build",
    "build:storybook": "storybook build -c packages/ui/.storybook -o storybook-static",
    "build:workbench": "pnpm --filter @personal-ui/workbench build",
    "test:browser:storybook": "playwright test",
    "test:browser:workbench": "playwright test -c playwright.workbench.config.ts",
    "test:browser:design-command-live": "playwright test -c playwright.designcommand.config.ts",
    "test:browser": "pnpm test:browser:storybook && pnpm test:browser:workbench && pnpm test:browser:design-command-live",
    "typecheck:jev": "tsc -p tools/loop/jev",
    "test:jev": "vitest run tools/loop/jev",
    "jev": "node tools/loop/jev/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "serve": "14.2.6",
    "shadcn": "4.21.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "@loop-engineering/jev-core": "file:vendor/loop-engineering-jev-core-0.1.0-61b057ac.tgz"
  }
}
